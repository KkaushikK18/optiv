# AI File Analysis System Environment Configuration

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false
SECRET_KEY=your-secret-key-here-change-in-production

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_file_analysis
DB_USER=postgres
DB_PASSWORD=password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Machine Learning Configuration
MODEL_PATH=models/
ML_BATCH_SIZE=32
MAX_FILE_SIZE=104857600  # 100MB in bytes

# File Storage
UPLOAD_PATH=uploads/
TEMP_PATH=temp/

# External APIs (optional)
VIRUSTOTAL_API_KEY=your-virustotal-api-key
MITRE_API_KEY=your-mitre-api-key

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log